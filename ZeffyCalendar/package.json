{
  "name": "zeffycalendar",
  "version": "1.0.0",
  "description": "A calendar web page for Zeffy events, designed for Google Apps Script.",
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development && vite build --config vite.config.tests.js",
    "preview": "vite preview",
    "deploy": "npm run build && clasp push",
    "deploy:dev": "npm run build:dev && clasp push",
    "open:script": "clasp open-script",
    "open:calendar": "npm run deploy:dev && open https://script.google.com/macros/s/AKfycbzD-yfUVsv3XihQT0XQHGGuCecazv_RehjjMv2mvDk/dev"
  },
  "dependencies": {
    "@makerspace/membership-common": "1.0.0",
    "@popperjs/core": "^2.11.8",
    "v-calendar": "^3.1.2",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-alpha.13",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "rollup-plugin-copy": "^3.5.0",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.8",
    "vite-plugin-clean": "^1.0.0",
    "vite-plugin-singlefile": "^2.0.1",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "google-apps-script",
    "calendar",
    "vue"
  ],
  "author": "",
  "license": "ISC",
  "type": "module"
}
